PORT=3000
APP_TIMEZONE=America/Bogota
DATABASE_URL="file:./dev.db"

# Twilio Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp Number (Sandbox o nÃºmero de producciÃ³n)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Tu nÃºmero de WhatsApp personal
MY_WHATSAPP_NUMBER=whatsapp:+57xxxxxxxxxx

# URL pÃºblica para webhooks (usar ngrok para desarrollo local)
PUBLIC_BASE_URL=https://your-domain.com

# Ruta del webhook
TWILIO_WEBHOOK_PATH=/webhooks/twilio/whatsapp

# Cloudinary (evidencias de imágenes; si está vacío se usa /webhooks/temp-media o imgbb)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secreto compartido HTTP (Firebase u otra app) → POST /api/integration/firebase/whatsapp
INTEGRATION_FIREBASE_SECRET=

# V8 — disponibilidad mensajeros (Harold/Diego/Dilan) según planilla Turnos
# Aliases aceptados: V8_WEBHOOK_URL / V8_API_KEY (mismo valor que HORARIOS_APP_API_KEY en Firebase V8)
V8_DISPONIBILIDAD_URL=https://us-central1-ultralents-v3-2025.cloudfunctions.net/recibirHorariosDisponibilidad
V8_WEBHOOK_URL=
V8_DISPONIBILIDAD_API_KEY=
V8_API_KEY=
V8_DISPONIBILIDAD_ENABLED=true
# JSON completo de service account (o base64) — proyecto cajacentro-v6, colección programacionAlmuerzos
FIREBASE_TURNOS_SERVICE_ACCOUNT_JSON=
FIREBASE_TURNOS_PROJECT_ID=cajacentro-v6

# Tareas WhatsApp aseo/cocina/basura — cron en Render (planilla Firebase = fuente única)
TURNOS_TAREAS_ENABLED=true

# URL pública del recibo de nómina (frontend Vercel, NO el backend Render)
NOMINA_PUBLIC_BASE_URL=https://whatsapp-reminders.vercel.app
FRONTEND_URL=
